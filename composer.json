{
    "name": "okarabudka/pdf-from-md",
    "description": "CLI tool that compiles a folder of numbered Markdown files into one PDF book with pandoc.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Oleksandr Karabudka",
            "email": "sanyakarabudka@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Okarabudka\\PdfFromMd\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Okarabudka\\PdfFromMd\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/export.php"
    ],
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --no-progress"
    },
    "config": {
        "sort-packages": true
    }
}
